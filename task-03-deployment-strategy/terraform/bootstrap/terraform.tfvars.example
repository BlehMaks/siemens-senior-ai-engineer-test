project_id         = "example-assignment-dev"
region             = "europe-west3"
environment        = "dev"
system_code        = "sai"
# Set TF_VAR_budget_amount_units in the operator's private environment.
bootstrap_state_bucket_name   = "example-assignment-dev-sai-bootstrap-tf-state"
application_state_bucket_name = "example-assignment-dev-sai-app-tf-state"
secret_ids = {
  api_key_pepper    = "sai-dev-api-key-pepper"
  task_signing_hmac = "sai-dev-task-signing-hmac"
}
enable_github_wif    = true
github_repository    = "example-org/siemens-senior-ai-engineer-test"
github_branch        = "master"
github_environment   = "gcp-dev"
github_reviewer      = "example-reviewer"

labels = {
  owner = "platform"
  cost  = "assessment"
}
